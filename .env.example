# Second Brain — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token with repo + read:user scopes (main account)
GITHUB_PAT=your_github_pat_here

# PAT for the Project Chimera GitHub account
# Used when cwd contains "chimera" — heartbeat queries both accounts automatically
GITHUB_PAT_CHIMERA=your_chimera_github_pat_here

# ── Brain (cross-project memory) ─────────────────────────────────────────────
# Absolute paths (use forward slashes on Windows too).
# BRAIN_ROOT    = cross-project memory (SOUL, USER, daily logs, intent, learnings)
# PROJECTS_ROOT = project code + that project's Snapshot.md
BRAIN_ROOT=D:/Brain
PROJECTS_ROOT=D:/Projects
# Back-compat alias for older scripts that still read VAULT_ROOT
VAULT_ROOT=D:/Brain

# ── ComfyUI ──────────────────────────────────────────────────────────────────
# Leave default if running locally on port 8188
COMFYUI_BASE_URL=http://localhost:8188

# ── FastEmbed ────────────────────────────────────────────────────────────────
# Optional: override model cache location (defaults to ~/.cache/fastembed)
# FASTEMBED_CACHE_PATH=C:/Users/Alec/.cache/fastembed
