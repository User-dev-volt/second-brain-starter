+import { describe, it, expect } from 'vitest'
+import type { AffixEntry } from '../../shared/types/itemDatabase'
+import { humanizeStatKey, formatAffixDescription, formatTierRange, formatFullTierRange } from './affixDescription'
+
+// Real-shaped affixes mirroring affixes.json (Story 4.0 corpus). Values are asserted, not snapshotted â€”
+// these are the SYNTHESIZED / DERIVED honesty surfaces (Source Audit).
+
+const increasedFireDamage: AffixEntry = {
+  id: 'affix-pyromancer-s-prefix',
+  name: "Pyromancer's",
+  type: 'prefix',
+  itemSlots: ['weapon', 'gloves'],
+  statKey: 'increased_fire_damage',
+  modifierType: 'increased',
+  scope: 'generic',
+  damageType: 'fire',
+  tiers: [
+    { tier: 1, minValue: 6, maxValue: 12 },
+    { tier: 2, minValue: 48, maxValue: 64 },
+  ],
+  extraStats: [],
+}
+
+const flatArmour: AffixEntry = {
+  id: 'affix-flat-armour',
+  name: 'of Plating',
+  type: 'suffix',
+  itemSlots: ['chest'],
+  statKey: 'armor',
+  modifierType: 'flat',
+  scope: 'generic',
+  damageType: null,
+  tiers: [
+    { tier: 1, minValue: 4, maxValue: 24 },
+    { tier: 2, minValue: 8, maxValue: 8 },
+  ],
+  extraStats: [],
+}
+
+const hybridGlacial: AffixEntry = {
+  id: 'affix-glacial-prefix',
+  name: 'Glacial',
+  type: 'prefix',
+  itemSlots: ['weapon'],
+  statKey: 'freeze_rate_multiplier',
+  modifierType: 'flat',
+  scope: 'generic',
+  damageType: null,
+  tiers: [{ tier: 1, minValue: 20, maxValue: 40 }],
+  extraStats: [
+    {
+      statKey: 'cold_resistance',
+      modifierType: 'flat',
+      scope: 'generic',
+      damageType: null,
+      tiers: [{ tier: 1, minValue: 5, maxValue: 5 }],
+    },
+  ],
+}
+
+const inertStub: AffixEntry = {
+  id: 'affix-inert',
+  name: 'of Nothing',
+  type: 'suffix',
+  itemSlots: [],
+  statKey: null,
+  tiers: [{ tier: 1, minValue: 0, maxValue: 0 }],
+}
+
+describe('humanizeStatKey', () => {
+  it('title-cases a compound damage key', () => {
+    expect(humanizeStatKey('increased_fire_damage')).toBe('Increased Fire Damage')
+  })
+  it('humanizes a penetration key', () => {
+    expect(humanizeStatKey('void_penetration')).toBe('Void Penetration')
+  })
+  it('applies abbreviation overrides (hp â†’ Health, max â†’ Maximum)', () => {
+    expect(humanizeStatKey('max_hp')).toBe('Maximum Health')
+    expect(humanizeStatKey('hp_regen_per_sec')).toBe('Health Regen per Second')
+  })
+  it('keeps connector words lowercase', () => {
+    expect(humanizeStatKey('area_of_effect')).toBe('Area of Effect')
+  })
+  it('uses the LE spelling for armour', () => {
+    expect(humanizeStatKey('armor')).toBe('Armour')
+  })
+  it('drops the redundant percent token (unit conveys it)', () => {
+    expect(humanizeStatKey('max_hp_percent')).toBe('Maximum Health')
+  })
+})
+
+describe('formatAffixDescription', () => {
+  it('synthesizes the description from the real statKey', () => {
+    expect(formatAffixDescription(increasedFireDamage)).toBe('Increased Fire Damage')
+  })
+  it('appends the second stat for a hybrid affix', () => {
+    expect(formatAffixDescription(hybridGlacial)).toBe('Freeze Rate Multiplier + Cold Resistance')
+  })
+  it('falls back to the affix name when no statKey resolved', () => {
+    expect(formatAffixDescription(inertStub)).toBe('of Nothing')
+  })
+})
+
+describe('formatTierRange', () => {
+  it('renders an increased range with a percent unit', () => {
+    expect(formatTierRange(increasedFireDamage, 2)).toBe('48â€“64%')
+  })
+  it('renders a flat range as a signed number', () => {
+    expect(formatTierRange(flatArmour, 1)).toBe('+4 â†’ +24')
+  })
+  it('collapses a zero-width flat range to a single signed value', () => {
+    expect(formatTierRange(flatArmour, 2)).toBe('+8')
+  })
+  it('returns empty string for an out-of-range tier', () => {
+    expect(formatTierRange(increasedFireDamage, 99)).toBe('')
+  })
+})
+
+describe('formatFullTierRange', () => {
+  it('bridges T1 min to Tmax max for an increased affix', () => {
+    expect(formatFullTierRange(increasedFireDamage)).toBe('6â€“64%')
+  })
+  it('bridges the full flat range with signs', () => {
+    expect(formatFullTierRange(flatArmour)).toBe('+4 â†’ +8')
+  })
+})
diff --git a/lebo/src/features/item-database/affixDescription.ts b/lebo/src/features/item-database/affixDescription.ts
new file mode 100644
index 0000000..a083d8e
--- /dev/null
+++ b/lebo/src/features/item-database/affixDescription.ts
@@ -0,0 +1,84 @@
+// Story 4.3 â€” SYNTHESIZED one-line affix descriptions and tier-range strings.
+//
+// FR-28 mandates a one-line description for every affix, but the shipped corpus carries NO
+// `description` field (0/1117) â€” only unique/set items ship display text, craftable affixes do not.
+// These helpers synthesize a display string from the REAL fields the corpus DOES carry
+// (name, statKey, modifierType, damageType, per-tier min/max). They fabricate nothing; the statKey
+// vocabulary is self-describing (e.g. `increased_fire_damage` already encodes modifier + element).
+//
+// Declared derivations (Source Audit): the description text and the "%" unit are DERIVED, not stored.
+
+import type { AffixEntry, AffixModifierType } from '../../shared/types/itemDatabase'
+
+// LE in-game spellings / abbreviations that a bare title-case would mangle.
+const TOKEN_OVERRIDE: Record<string, string> = {
+  hp: 'Health',
+  max: 'Maximum',
+  regen: 'Regen',
+  sec: 'Second',
+  armor: 'Armour',
+}
+// Connector words kept lowercase when they are not the first token.
+const LOWER_TOKENS = new Set(['of', 'per', 'and'])
+// The "percent" token is redundant with the derived "%" unit â€” drop it from the name.
+const DROP_TOKENS = new Set(['percent'])
+
+// Humanize a snake_case statKey into a display name. Deterministic; reads only the statKey.
+export function humanizeStatKey(statKey: string): string {
+  const tokens = statKey.split('_').filter((t) => t.length > 0 && !DROP_TOKENS.has(t))
+  return tokens
+    .map((t, i) => {
+      if (TOKEN_OVERRIDE[t]) return TOKEN_OVERRIDE[t]
+      if (i > 0 && LOWER_TOKENS.has(t)) return t
+      return t.charAt(0).toUpperCase() + t.slice(1)
+    })
+    .join(' ')
+}
+
+// Flat additive stats read as a signed number ("+4 â†’ +24"); increased/more/conversion read as a
+// percentage ("48â€“64%"). No unit is stored in the corpus â€” this is derived from modifierType.
+function isFlat(modifierType: AffixModifierType | undefined): boolean {
+  return modifierType === 'flat'
+}
+
+function fmtNum(n: number): string {
+  return Number.isInteger(n) ? String(n) : String(Math.round(n * 100) / 100)
+}
+
+// A deterministic one-line description synthesized from real fields. Falls back to the affix name
+// when no statKey resolved (the 514 inert stubs â€” which the picker never renders anyway).
+export function formatAffixDescription(affix: AffixEntry): string {
+  if (!affix.statKey) return affix.name
+  let description = humanizeStatKey(affix.statKey)
+  const second = affix.extraStats?.[0]?.statKey
+  if (second) description += ` + ${humanizeStatKey(second)}`
+  return description
+}
+
+// The stat range for a given tier, e.g. "48â€“64%" (increased) or "+4 â†’ +24" (flat). Returns '' if the
+// tier is out of range. Collapses a zero-width range (min === max) to a single value.
+export function formatTierRange(affix: AffixEntry, tier: number): string {
+  const t = affix.tiers[tier - 1]
+  if (!t) return ''
+  const min = fmtNum(t.minValue)
+  const max = fmtNum(t.maxValue)
+  const collapsed = t.minValue === t.maxValue
+  if (isFlat(affix.modifierType)) {
+    return collapsed ? `+${min}` : `+${min} â†’ +${max}`
+  }
+  return collapsed ? `${min}%` : `${min}â€“${max}%`
+}
+
+// The full-tier stat range across T1â†’Tmax, used in the picker row (AC1). Bridges the lowest tier's
+// min to the highest tier's max, e.g. "6â€“240%".
+export function formatFullTierRange(affix: AffixEntry): string {
+  if (affix.tiers.length === 0) return ''
+  const first = affix.tiers[0]
+  const last = affix.tiers[affix.tiers.length - 1]
+  const min = fmtNum(first.minValue)
+  const max = fmtNum(last.maxValue)
+  if (isFlat(affix.modifierType)) {
+    return min === max ? `+${min}` : `+${min} â†’ +${max}`
+  }
+  return min === max ? `${min}%` : `${min}â€“${max}%`
+}
