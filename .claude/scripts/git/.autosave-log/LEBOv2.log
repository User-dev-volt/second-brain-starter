+  // Story 4.0 corpus fields â€” they flow over IPC (RawAffix) but were under-declared in TS until
+  // Story 4.3 surfaced them for the affix picker's grouping / description / slot-scope derivations.
+  statKey?: string | null
+  modifierType?: AffixModifierType
