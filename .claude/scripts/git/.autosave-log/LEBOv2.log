diff --git a/lebo/src/features/item-database/affixCategory.test.ts b/lebo/src/features/item-database/affixCategory.test.ts
new file mode 100644
index 0000000..4409f28
--- /dev/null
+++ b/lebo/src/features/item-database/affixCategory.test.ts
@@ -0,0 +1,43 @@
+import { describe, it, expect } from 'vitest'
+import { getAffixCategory, CATEGORY_LABEL, CATEGORY_ORDER } from './affixCategory'
+
+describe('getAffixCategory', () => {
+  it('maps damage / crit / penetration / speed keys to Offense', () => {
+    expect(getAffixCategory('increased_fire_damage')).toBe('offense')
+    expect(getAffixCategory('critical_strike_multiplier')).toBe('offense')
+    expect(getAffixCategory('void_penetration')).toBe('offense')
+    expect(getAffixCategory('attack_speed')).toBe('offense')
+  })
+
+  it('maps resistances / HP / armour / dodge keys to Defense', () => {
+    expect(getAffixCategory('fire_resistance')).toBe('defense')
+    expect(getAffixCategory('max_hp')).toBe('defense')
+    expect(getAffixCategory('armor')).toBe('defense')
+    expect(getAffixCategory('dodge_rating')).toBe('defense')
+  })
+
+  it('maps attributes / movement / leech keys to Utility', () => {
+    expect(getAffixCategory('strength')).toBe('utility')
+    expect(getAffixCategory('movement_speed')).toBe('utility')
+    expect(getAffixCategory('life_leech_percent')).toBe('utility')
+  })
+
+  it('routes minion damage to Utility (minion wins over the damage signal)', () => {
+    expect(getAffixCategory('increased_minion_damage')).toBe('utility')
+  })
+
+  it('falls back to Utility for an unmapped key (declared default)', () => {
+    expect(getAffixCategory('some_future_unmapped_key')).toBe('utility')
+  })
+
+  it('falls back to Utility for a null / undefined statKey (the inert stubs)', () => {
+    expect(getAffixCategory(null)).toBe('utility')
+    expect(getAffixCategory(undefined)).toBe('utility')
+  })
+})
+
+describe('category presentation', () => {
+  it('renders Offense â†’ Defense â†’ Utility in order', () => {
+    expect(CATEGORY_ORDER.map((c) => CATEGORY_LABEL[c])).toEqual(['Offense', 'Defense', 'Utility'])
+  })
+})
diff --git a/lebo/src/features/item-database/affixCategory.ts b/lebo/src/features/item-database/affixCategory.ts
new file mode 100644
index 0000000..e1e99ee
--- /dev/null
+++ b/lebo/src/features/item-database/affixCategory.ts
@@ -0,0 +1,100 @@
+// Story 4.3 â€” DERIVED Offense / Defense / Utility grouping for the affix picker.
+//
+// FR-28 mandates an Offense/Defense/Utility tag on every affix, but the shipped corpus
+// (affixes.json) carries NO `category` field (0/1117). This is an authored map over the 55 resolved
+// statKeys, seeded from the engine's own StatKey section headers (scoring-core modifier.rs /
+// game_data_loader.rs `stat_key_from_str`). It reads the real `statKey` â€” it fabricates nothing.
+//
+// Rule (declared in the Source Audit): any statKey NOT explicitly mapped here â€” including a null
+// statKey (the 514 inert stubs) â€” falls to Utility. The buckets are grouped by the seed reasoning so
+// the classification is auditable at a glance.
+
+export type AffixCategory = 'offense' | 'defense' | 'utility'
+
+// Damage / crit / penetration / attack+cast speed / area.
+const OFFENSE_KEYS: readonly string[] = [
+  'increased_damage',
+  'increased_spell_damage',
+  'increased_melee_damage',
+  'increased_ranged_damage',
+  'increased_fire_damage',
+  'increased_cold_damage',
+  'increased_lightning_damage',
+  'increased_physical_damage',
+  'increased_void_damage',
+  'increased_necrotic_damage',
+  'increased_poison_damage',
+  'increased_bleed_damage',
+  'more_damage',
+  'critical_strike_chance',
+  'critical_strike_multiplier',
+  'physical_penetration',
+  'fire_penetration',
+  'cold_penetration',
+  'lightning_penetration',
+  'void_penetration',
+  'elemental_penetration',
+  'attack_speed',
+  'cast_speed',
+  'area_of_effect',
+]
+
+// Resistances / max HP / ward / armour / dodge / block / endurance / crit-avoidance /
+// healing-effectiveness / regen.
+const DEFENSE_KEYS: readonly string[] = [
+  'fire_resistance',
+  'cold_resistance',
+  'lightning_resistance',
+  'void_resistance',
+  'necrotic_resistance',
+  'poison_resistance',
+  'physical_resistance',
+  'all_resistances',
+  'max_hp',
+  'max_hp_percent',
+  'hp_regen_per_sec',
+  'ward_per_second',
+  'armor',
+  'dodge_rating',
+  'block_chance',
+  'endurance_threshold',
+  'endurance_percent',
+  'critical_strike_avoidance',
+  'healing_effectiveness',
+]
+
+// Attributes / movement speed / leech / ailment durations / minion (minion wins over the "damage"
+// signal in increased_minion_damage â€” per the seed, minion â†’ Utility).
+const UTILITY_KEYS: readonly string[] = [
+  'strength',
+  'dexterity',
+  'intelligence',
+  'vitality',
+  'attunement',
+  'movement_speed',
+  'life_leech_percent',
+  'bleed_duration',
+  'poison_duration',
+  'ignite_duration',
+  'freeze_rate_multiplier',
+  'increased_minion_damage',
+]
+
+const CATEGORY_BY_KEY: Record<string, AffixCategory> = {}
+for (const k of OFFENSE_KEYS) CATEGORY_BY_KEY[k] = 'offense'
+for (const k of DEFENSE_KEYS) CATEGORY_BY_KEY[k] = 'defense'
+for (const k of UTILITY_KEYS) CATEGORY_BY_KEY[k] = 'utility'
+
+export function getAffixCategory(statKey: string | null | undefined): AffixCategory {
+  if (!statKey) return 'utility'
+  return CATEGORY_BY_KEY[statKey] ?? 'utility'
+}
+
+export const CATEGORY_LABEL: Record<AffixCategory, string> = {
+  offense: 'Offense',
+  defense: 'Defense',
+  utility: 'Utility',
+}
+
+// Fixed render order for the grouped picker (Offense â†’ Defense â†’ Utility).
+export const CATEGORY_ORDER: readonly AffixCategory[] = ['offense', 'defense', 'utility']
