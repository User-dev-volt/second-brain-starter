diff --git a/lebo/src/features/item-database/AffixPickerModal.test.tsx b/lebo/src/features/item-database/AffixPickerModal.test.tsx
new file mode 100644
index 0000000..3f04619
--- /dev/null
+++ b/lebo/src/features/item-database/AffixPickerModal.test.tsx
@@ -0,0 +1,239 @@
+import { describe, it, expect, vi } from 'vitest'
+import { render, screen, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { axe } from 'vitest-axe'
+import { AffixPickerModal } from './AffixPickerModal'
+import type { ItemDatabase, AffixEntry } from '../../shared/types/itemDatabase'
+
+// Real-shaped corpus (Story 4.0 fields): statKey, modifierType, itemSlots, per-tier min/max, type.
+// The picker DERIVES grouping/description and FILTERS by slot from these â€” assert real behaviour,
+// not "a modal opens".
+const affixes: AffixEntry[] = [
+  {
+    id: 'affix-fire',
+    name: "Pyromancer's",
+    type: 'prefix',
+    itemSlots: ['weapon', 'gloves'],
+    statKey: 'increased_fire_damage',
+    modifierType: 'increased',
+    damageType: 'fire',
+    tiers: [
+      { tier: 1, minValue: 6, maxValue: 12 },
+      { tier: 2, minValue: 48, maxValue: 64 },
+    ],
+    extraStats: [],
+  },
+  {
+    id: 'affix-void',
+    name: 'Inevitable',
+    type: 'prefix',
+    itemSlots: ['weapon'], // WEAPON-ONLY â€” the AC3 probe
+    statKey: 'void_penetration',
+    modifierType: 'flat',
+    damageType: 'void',
+    tiers: [
+      { tier: 1, minValue: 4, maxValue: 4 },
+      { tier: 2, minValue: 5, maxValue: 5 },
+      { tier: 3, minValue: 6, maxValue: 6 },
+    ],
+    extraStats: [],
+  },
+  {
+    id: 'affix-fireres',
+    name: 'of Embers',
+    type: 'suffix',
+    itemSlots: ['weapon', 'helm', 'chest', 'boots'],
+    statKey: 'fire_resistance',
+    modifierType: 'flat',
+    damageType: null,
+    tiers: [{ tier: 1, minValue: 5, maxValue: 9 }],
+    extraStats: [],
+  },
+  {
+    id: 'affix-str',
+    name: 'of the Bear',
+    type: 'suffix',
+    itemSlots: ['weapon', 'helm'],
+    statKey: 'strength',
+    modifierType: 'flat',
+    damageType: null,
+    tiers: [
+      { tier: 1, minValue: 1, maxValue: 2 },
+      { tier: 2, minValue: 3, maxValue: 4 },
+    ],
+    extraStats: [],
+  },
+  {
+    id: 'affix-boots-ms',
+    name: 'of Haste',
+    type: 'suffix',
+    itemSlots: ['boots'],
+    statKey: 'movement_speed',
+    modifierType: 'flat',
+    damageType: null,
+    tiers: [{ tier: 1, minValue: 4, maxValue: 8 }],
+    extraStats: [],
+  },
+  {
+    // Inert stub: null statKey + empty itemSlots (one of the 514). Must NEVER render.
+    id: 'affix-stub',
+    name: 'of Nothing',
+    type: 'suffix',
+    itemSlots: [],
+    statKey: null,
+    tiers: [{ tier: 1, minValue: 0, maxValue: 0 }],
+  },
+]
+
+const itemDatabase: ItemDatabase = { baseItems: [], uniqueItems: [], affixes, setItems: [] }
+
+function renderModal(overrides: Partial<React.ComponentProps<typeof AffixPickerModal>> = {}) {
+  const onApply = vi.fn()
+  const onClose = vi.fn()
+  const utils = render(
+    <AffixPickerModal
+      slotId="weapon"
+      slotName="Weapon"
+      itemDatabase={itemDatabase}
+      existingAffixIds={[]}
+      onApply={onApply}
+      onClose={onClose}
+      {...overrides}
+    />,
+  )
+  return { onApply, onClose, ...utils }
+}
+
+describe('AffixPickerModal', () => {
+  it('groups affixes under Offense / Defense / Utility (derived)', () => {
+    renderModal()
+    expect(screen.getByRole('group', { name: 'Offense' })).toBeInTheDocument()
+    expect(screen.getByRole('group', { name: 'Defense' })).toBeInTheDocument()
+    expect(screen.getByRole('group', { name: 'Utility' })).toBeInTheDocument()
+    // increased_fire_damage â†’ Offense
+    const offense = screen.getByRole('group', { name: 'Offense' })
+    expect(within(offense).getByRole('button', { name: /Pyromancer's/ })).toBeInTheDocument()
+    // fire_resistance â†’ Defense; strength â†’ Utility
+    expect(within(screen.getByRole('group', { name: 'Defense' })).getByRole('button', { name: /of Embers/ })).toBeInTheDocument()
+    expect(within(screen.getByRole('group', { name: 'Utility' })).getByRole('button', { name: /of the Bear/ })).toBeInTheDocument()
+  })
+
+  it('renders the category tag "{Category} Â· max T{n}" from tiers.length', () => {
+    renderModal()
+    // Pyromancer's has 2 tiers â†’ "Offense Â· max T2"; Inevitable has 3 â†’ "Offense Â· max T3"
+    expect(screen.getByText('Offense Â· max T2')).toBeInTheDocument()
+    expect(screen.getByText('Offense Â· max T3')).toBeInTheDocument()
+  })
+
+  it('renders the synthesized description and full-tier range on a row', () => {
+    renderModal()
+    expect(screen.getByText('Increased Fire Damage')).toBeInTheDocument()
+    expect(screen.getByText('6â€“64%')).toBeInTheDocument() // T1 min â†’ Tmax max
+  })
+
+  it('EXCLUDES the inert stubs (null statKey / empty itemSlots) â€” the 514 never render', () => {
+    renderModal()
+    expect(screen.queryByRole('button', { name: /of Nothing/ })).toBeNull()
+  })
+
+  it('AC3: a weapon-only affix shows for the weapon slot', () => {
+    renderModal({ slotId: 'weapon', slotName: 'Weapon' })
+    expect(screen.getByRole('button', { name: /Inevitable/ })).toBeInTheDocument()
+  })
+
+  it('AC3: the same weapon-only affix is HIDDEN for a boots slot', () => {
+    renderModal({ slotId: 'boots', slotName: 'Boots' })
+    expect(screen.queryByRole('button', { name: /Inevitable/ })).toBeNull()
+    // a boots-valid affix still shows
+    expect(screen.getByRole('button', { name: /of Haste/ })).toBeInTheDocument()
+    // and the weapon fire affix does not
+    expect(screen.queryByRole('button', { name: /Pyromancer's/ })).toBeNull()
+  })
+
+  it('search matches the humanized stat name, not just the affix name', async () => {
+    renderModal()
+    await userEvent.type(screen.getByRole('textbox', { name: 'Search affixes' }), 'fire')
+    // Pyromancer's (name lacks "fire" but statKey â†’ "Increased Fire Damage") + of Embers (Fire Resistance)
+    expect(screen.getByRole('button', { name: /Pyromancer's/ })).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: /of Embers/ })).toBeInTheDocument()
+    // non-fire affixes gone
+    expect(screen.queryByRole('button', { name: /Inevitable/ })).toBeNull()
+    expect(screen.queryByRole('button', { name: /of the Bear/ })).toBeNull()
+  })
+
+  it('reports the slot-scoped match count in a live region', () => {
+    renderModal()
+    // weapon-visible: fire, void, fireres, str = 4
+    expect(screen.getByRole('status')).toHaveTextContent('4 affixes for Weapon')
+  })
+
+  it('AC2: selecting an affix reveals the tier control; clicking a pip updates the live value', async () => {
+    renderModal()
+    await userEvent.click(screen.getByRole('button', { name: /Inevitable/ }))
+    // seeded to medianTier = ceil(3/2) = 2 â†’ "T2 â†’ +5"
+    const slider = await screen.findByRole('slider', { name: 'Inevitable tier' })
+    expect(slider).toBeInTheDocument()
+    expect(screen.getByText('T2 â†’ +5')).toBeInTheDocument()
+    slider.focus()
+    await userEvent.keyboard('{ArrowRight}')
+    // tier 3 â†’ +6
+    expect(screen.getByText('T3 â†’ +6')).toBeInTheDocument()
+  })
+
+  it('AC2: Apply (add mode) calls onApply with the chosen affix and tier', async () => {
+    const { onApply } = renderModal()
+    await userEvent.click(screen.getByRole('button', { name: /Inevitable/ }))
+    await userEvent.click(screen.getByRole('button', { name: 'Apply' }))
+    expect(onApply).toHaveBeenCalledTimes(1)
+    const [affix, tier] = onApply.mock.calls[0]
+    expect(affix.id).toBe('affix-void')
+    expect(tier).toBe(2) // median seed
+  })
+
+  it('Apply is disabled until an affix is selected', () => {
+    renderModal()
+    expect(screen.getByRole('button', { name: 'Apply' })).toBeDisabled()
+  })
+
+  it('replace mode pre-selects the affix at the given tier and excludes the others', async () => {
+    const { onApply } = renderModal({
+      replacingAffixId: 'affix-void',
+      initialTier: 1,
+      existingAffixIds: ['affix-void', 'affix-fire'],
+    })
+    // pre-selected â†’ Apply enabled immediately, tier seeded to initialTier 1
+    expect(screen.getByText('T1 â†’ +4')).toBeInTheDocument()
+    // the OTHER existing affix (affix-fire) is excluded; the one being replaced stays
+    expect(screen.queryByRole('button', { name: /Pyromancer's/ })).toBeNull()
+    expect(screen.getByRole('button', { name: /Inevitable/ })).toBeInTheDocument()
+    await userEvent.click(screen.getByRole('button', { name: 'Apply' }))
+    const [affix, tier] = onApply.mock.calls[0]
+    expect(affix.id).toBe('affix-void')
+    expect(tier).toBe(1)
+  })
+
+  it('renders "Database unavailable" when the item DB is null', () => {
+    renderModal({ itemDatabase: null })
+    expect(screen.getByText('Database unavailable')).toBeInTheDocument()
+  })
+
+  // Accessibility (NFR-14 / Task 7) â€” axe in empty, grouped, and selected states.
+  it('axe: zero violations in the grouped-list state', async () => {
+    const { container } = renderModal()
+    expect(await axe(container)).toHaveNoViolations()
+  })
+
+  it('axe: zero violations in the no-match (empty) state', async () => {
+    const { container } = renderModal()
+    await userEvent.type(screen.getByRole('textbox', { name: 'Search affixes' }), 'zzzznomatch')
+    expect(screen.getByText('Try a different search.')).toBeInTheDocument()
+    expect(await axe(container)).toHaveNoViolations()
+  })
+
+  it('axe: zero violations with an affix selected', async () => {
+    const { container } = renderModal()
+    await userEvent.click(screen.getByRole('button', { name: /Inevitable/ }))
+    await screen.findByRole('slider', { name: 'Inevitable tier' })
+    expect(await axe(container)).toHaveNoViolations()
+  })
+})
diff --git a/lebo/src/features/item-database/AffixPickerModal.tsx b/lebo/src/features/item-database/AffixPickerModal.tsx
new file mode 100644
index 0000000..4d2de8e
--- /dev/null
+++ b/lebo/src/features/item-database/AffixPickerModal.tsx
@@ -0,0 +1,268 @@
+import { useMemo, useState } from 'react'
+import { Dialog, DialogPanel, DialogTitle } from '@headlessui/react'
+import type { AffixEntry, ItemDatabase } from '../../shared/types/itemDatabase'
+import { dbSlotsForGearSlot } from './slotMap'
+import { getAffixCategory, CATEGORY_LABEL, CATEGORY_ORDER, type AffixCategory } from './affixCategory'
+import { formatAffixDescription, formatFullTierRange, humanizeStatKey } from './affixDescription'
+import { AffixTierControl } from './AffixTierControl'
+
+interface AffixPickerModalProps {
+  slotId: string
+  slotName: string
+  itemDatabase: ItemDatabase | null
+  // Affixes already on the item. In ADD mode all are excluded (no duplicates). In REPLACE mode the
+  // affix being swapped (`replacingAffixId`) stays selectable so the user can re-pick it or change tier.
+  existingAffixIds: string[]
+  replacingAffixId?: string
+  initialTier?: number
+  onApply: (affix: AffixEntry, tier: number) => void
+  onClose: () => void
+}
+
+function medianTier(affix: AffixEntry): number {
+  return Math.ceil(affix.tiers.length / 2)
+}
+
+export function AffixPickerModal({
+  slotId,
+  slotName,
+  itemDatabase,
+  existingAffixIds,
+  replacingAffixId,
+  initialTier,
+  onApply,
+  onClose,
+}: AffixPickerModalProps) {
+  const dbSlots = useMemo(() => dbSlotsForGearSlot(slotId), [slotId])
+  const isReplace = replacingAffixId !== undefined
+
+  const [query, setQuery] = useState('')
+  const [selectedId, setSelectedId] = useState<string | null>(replacingAffixId ?? null)
+  const [tierOverride, setTierOverride] = useState<number | null>(null)
+
+  // Slot-scoped, picker-visible affixes (AC3 + the 603 scope in one predicate): a non-empty
+  // `itemSlots` (â‡” resolved statKey â€” the 514 inert stubs have empty slots) that intersects this
+  // gear slot's DB slots. Array-intersection â€” NOT the 4.2 scalar item predicate. Empty = show nowhere.
+  const pickerAffixes = useMemo(() => {
+    if (!itemDatabase) return []
+    const exclude = new Set(existingAffixIds.filter((id) => id !== replacingAffixId))
+    return itemDatabase.affixes.filter(
+      (a) =>
+        !exclude.has(a.id) &&
+        a.itemSlots.length > 0 &&
+        a.itemSlots.some((s) => dbSlots.includes(s)),
+    )
+  }, [itemDatabase, existingAffixIds, replacingAffixId, dbSlots])
+
+  const filtered = useMemo(() => {
+    const q = query.trim().toLowerCase()
+    if (!q) return pickerAffixes
+    return pickerAffixes.filter((a) => {
+      const haystack = `${a.name} ${a.statKey ? humanizeStatKey(a.statKey) : ''} ${formatAffixDescription(a)}`
+      return haystack.toLowerCase().includes(q)
+    })
+  }, [pickerAffixes, query])
+
+  const groups = useMemo(() => {
+    const byCat: Record<AffixCategory, AffixEntry[]> = { offense: [], defense: [], utility: [] }
+    for (const a of filtered) byCat[getAffixCategory(a.statKey)].push(a)
+    for (const cat of CATEGORY_ORDER) byCat[cat].sort((a, b) => a.name.localeCompare(b.name))
+    return CATEGORY_ORDER.map((cat) => ({ cat, affixes: byCat[cat] })).filter((g) => g.affixes.length > 0)
+  }, [filtered])
+
+  const selectedAffix = useMemo(
+    () => (selectedId ? itemDatabase?.affixes.find((a) => a.id === selectedId) ?? null : null),
+    [selectedId, itemDatabase],
+  )
+
+  const seedTier = selectedAffix
+    ? selectedId === replacingAffixId && initialTier !== undefined
+      ? initialTier
+      : medianTier(selectedAffix)
+    : 1
+  const displayTier = tierOverride ?? seedTier
+
+  function selectAffix(id: string) {
+    setSelectedId(id)
+    setTierOverride(null)
+  }
+
+  function apply() {
+    if (selectedAffix) onApply(selectedAffix, displayTier)
+  }
+
+  return (
+    <Dialog open onClose={onClose} className="relative z-50">
+      <div className="fixed inset-0" style={{ backgroundColor: 'rgba(0,0,0,0.5)' }} aria-hidden="true" />
+
+      <div className="fixed inset-0 flex items-center justify-center p-4">
+        <DialogPanel
+          className="rounded-lg w-full max-w-2xl max-h-[85vh] flex flex-col shadow-xl overflow-hidden"
+          style={{ backgroundColor: 'var(--color-bg-surface)', border: '1px solid var(--color-bg-elevated)' }}
+        >
+          <div className="flex items-center justify-between px-5 pt-4 pb-3">
+            <DialogTitle className="text-base font-semibold" style={{ color: 'var(--color-text-primary)' }}>
+              {isReplace ? 'Replace' : 'Add'} affix â€” {slotName}
+            </DialogTitle>
+            <button
+              type="button"
+              onClick={onClose}
+              aria-label="Close affix picker"
+              className="text-lg leading-none"
+              style={{ color: 'var(--color-text-muted)', background: 'none', border: 'none', cursor: 'pointer' }}
+            >
+              Ã—
+            </button>
+          </div>
+
+          {itemDatabase === null ? (
+            <div className="px-5 pb-6" style={{ color: 'var(--color-text-muted)' }}>
+              <p className="text-sm">Database unavailable</p>
+            </div>
+          ) : (
+            <div className="flex-1 min-h-0 flex flex-col">
+              <div className="px-5 pb-3">
+                <input
+                  type="text"
+                  value={query}
+                  onChange={(e) => setQuery(e.target.value)}
+                  placeholder="Search by affix or stat nameâ€¦"
+                  aria-label="Search affixes"
+                  autoFocus
+                  className="w-full text-sm px-3 py-2 rounded"
+                  style={{
+                    backgroundColor: 'var(--color-bg-base)',
+                    color: 'var(--color-text-primary)',
+                    border: '1px solid var(--color-bg-elevated)',
+                  }}
+                />
+                <div role="status" aria-live="polite" className="text-xs mt-2" style={{ color: 'var(--color-text-muted)' }}>
+                  {filtered.length === 0
+                    ? 'No affixes match these filters'
+                    : `${filtered.length} affix${filtered.length === 1 ? '' : 'es'} for ${slotName}`}
+                </div>
+              </div>
+
+              <div className="flex-1 min-h-0 overflow-y-auto px-5 pb-2 flex flex-col gap-4">
+                {groups.length === 0 ? (
+                  <div className="flex-1 flex items-center justify-center text-sm py-8" style={{ color: 'var(--color-text-muted)' }}>
+                    Try a different search.
+                  </div>
+                ) : (
+                  groups.map((group) => (
+                    <div key={group.cat} role="group" aria-label={CATEGORY_LABEL[group.cat]}>
+                      <div
+                        className="text-[11px] uppercase tracking-wide mb-1.5 flex items-center gap-2"
+                        style={{ color: 'var(--color-text-muted)' }}
+                      >
+                        <span>{CATEGORY_LABEL[group.cat]}</span>
+                        <span style={{ color: 'var(--color-text-secondary)' }}>{group.affixes.length}</span>
+                      </div>
+                      <div className="flex flex-col gap-1">
+                        {group.affixes.map((affix) => {
+                          const isSelected = affix.id === selectedId
+                          return (
+                            <button
+                              key={affix.id}
+                              type="button"
+                              aria-pressed={isSelected}
+                              onClick={() => selectAffix(affix.id)}
+                              className="text-left rounded px-3 py-2 flex flex-col gap-0.5"
+                              style={{
+                                backgroundColor: isSelected ? 'var(--color-bg-hover)' : 'var(--color-bg-elevated)',
+                                border: isSelected
+                                  ? '1px solid var(--color-accent-gold)'
+                                  : '1px solid var(--color-bg-elevated)',
+                                cursor: 'pointer',
+                              }}
+                            >
+                              <span className="flex items-baseline justify-between gap-2">
+                                <span
+                                  className="text-[13px] font-semibold truncate"
+                                  style={{ color: isSelected ? 'var(--color-accent-gold)' : 'var(--color-text-primary)' }}
+                                >
+                                  {affix.name}
+                                </span>
+                                <span className="text-[11px] shrink-0" style={{ color: 'var(--color-text-muted)' }}>
+                                  {CATEGORY_LABEL[group.cat]} Â· max T{affix.tiers.length}
+                                </span>
+                              </span>
+                              <span className="flex items-baseline justify-between gap-2">
+                                <span className="text-[12px] truncate" style={{ color: 'var(--color-text-secondary)' }}>
+                                  {formatAffixDescription(affix)}
+                                </span>
+                                <span
+                                  className="text-[11px] shrink-0"
+                                  style={{ color: 'var(--color-text-muted)', fontFamily: 'var(--font-mono)' }}
+                                >
+                                  {formatFullTierRange(affix)}
+                                </span>
+                              </span>
+                            </button>
+                          )
+                        })}
+                      </div>
+                    </div>
+                  ))
+                )}
+              </div>
+
+              {/* Selected-affix tier row + Apply (AC2). Reuses AffixTierControl â€” the de-facto TierPips. */}
+              <div
+                className="flex items-center justify-between gap-3 px-5 py-3"
+                style={{ borderTop: '1px solid var(--color-bg-elevated)' }}
+              >
+                <div className="flex items-center gap-3 min-w-0">
+                  {selectedAffix ? (
+                    <>
+                      <span className="text-[13px] font-semibold truncate" style={{ color: 'var(--color-text-primary)' }}>
+                        {selectedAffix.name}
+                      </span>
+                      <AffixTierControl
+                        affixEntry={selectedAffix}
+                        currentTier={displayTier}
+                        onChange={(tier) => setTierOverride(tier)}
+                      />
+                    </>
+                  ) : (
+                    <span className="text-[12px]" style={{ color: 'var(--color-text-muted)' }}>
+                      Select an affix to set its tier
+                    </span>
+                  )}
+                </div>
+                <div className="flex items-center gap-3 shrink-0">
+                  <button
+                    type="button"
+                    onClick={onClose}
+                    className="px-4 py-1.5 text-sm rounded"
+                    style={{
+                      backgroundColor: 'var(--color-bg-elevated)',
+                      color: 'var(--color-text-primary)',
+                      border: '1px solid var(--color-bg-hover)',
+                    }}
+                  >
+                    Cancel
+                  </button>
+                  <button
+                    type="button"
+                    disabled={!selectedAffix}
+                    onClick={apply}
+                    className="px-4 py-1.5 text-sm rounded font-medium"
+                    style={{
+                      backgroundColor: selectedAffix ? 'var(--color-accent-gold)' : 'var(--color-bg-elevated)',
+                      color: selectedAffix ? 'var(--color-bg-base)' : 'var(--color-text-muted)',
+                      border: 'none',
+                      cursor: selectedAffix ? 'pointer' : 'not-allowed',
+                    }}
+                  >
+                    Apply
+                  </button>
+                </div>
+              </div>
+            </div>
+          )}
+        </DialogPanel>
+      </div>
+    </Dialog>
+  )
+}
