+}
+
+describe('GearTab', () => {
+  let initialBuildState: ReturnType<typeof useBuildStore.getState>
+
+  beforeAll(() => {
+    initialBuildState = useBuildStore.getState()
+  })
+
+  beforeEach(() => {
+    useBuildStore.setState(initialBuildState, true)
+    useGameDataStore.getState().setItemDatabase(null)
+  })
+
+  it('shows a guard prompt when there is no active build (gear cannot persist without one)', () => {
+    render(<GearTab />)
+    expect(screen.getByText('Create or load a build to edit gear.')).toBeInTheDocument()
+    expect(screen.queryByText('Equipment')).toBeNull()
+  })
+
+  it('renders the equipment slots once a build is active', () => {
+    useBuildStore.getState().setActiveBuild(mockBuild)
+    render(<GearTab />)
+    expect(screen.getByText('Equipment')).toBeInTheDocument()
+    expect(screen.queryByText('Create or load a build to edit gear.')).toBeNull()
+  })
+})
