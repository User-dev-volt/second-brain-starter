+
+function toResult(
+  item: { id: string; name: string; baseType: string; slot: string },
+  type: SearchResult['type']
+): SearchResult {
+  return { id: item.id, name: item.name, baseType: item.baseType, slot: item.slot, type }
+}
+
+// Reconstruct a SearchResult from a persisted GearItemV2.itemId so a loaded / tab-restored gear slot
+// can re-derive its display. Base ids are unique; set and unique ids can collide (see
+// GearSlot.resolveAffixes), so when both exist for one id the stored name breaks the tie â€” defaulting
+// to the set (which the equip path routes collisions to).
+export function findSearchResultById(
+  id: string,
+  name: string,
+  database: ItemDatabase
+): SearchResult | null {
+  const base = database.baseItems.find((b) => b.id === id)
+  if (base) return toResult(base, 'base')
+  const set = database.setItems.find((s) => s.id === id)
+  const unique = database.uniqueItems.find((u) => u.id === id)
+  if (set && unique) {
+    return unique.name === name && set.name !== name ? toResult(unique, 'unique') : toResult(set, 'set')
+  }
+  if (set) return toResult(set, 'set')
+  if (unique) return toResult(unique, 'unique')
+  return null
+}
